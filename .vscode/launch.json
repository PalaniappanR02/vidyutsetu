{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VidyutSetu: run server (port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "VidyutSetu: run server with reload (port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "VidyutSetu: pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
