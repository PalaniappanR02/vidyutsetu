# Copy this file to .env for local development. Never commit .env or real credentials.
VIDYUTSETU_ENV=development
VIDYUTSETU_AUTH_MODE=demo
VIDYUTSETU_DATABASE_URL=sqlite:///./vidyutsetu.db
VIDYUTSETU_SESSION_TTL_MINUTES=480
VIDYUTSETU_COOKIE_SECURE=false
VIDYUTSETU_CORS_ORIGINS=
VIDYUTSETU_DEMO_ADMIN_USERNAME=admin
# Optional for a local demo. If blank on first startup, a random password is logged once.
VIDYUTSETU_INITIAL_ADMIN_PASSWORD=
VIDYUTSETU_LOGIN_ATTEMPT_LIMIT=5
VIDYUTSETU_LOGIN_ATTEMPT_WINDOW_SECONDS=300
VIDYUTSETU_SQLITE_BUSY_TIMEOUT_MS=5000
